# Copy this file to scripts/.env and replace the values you use.
WEAVEFLOW_IMAGE=weaveflow:0.1.0
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
WEAVEFLOW_MANAGEMENT_TOKEN=replace-with-a-long-random-token

