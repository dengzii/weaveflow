# WEAVEFLOW_PUBLISH_HOST=127.0.0.1
# WEAVEFLOW_PUBLISH_PORT=8080
# WEAVEFLOW_WORKSPACE=..
# WEAVEFLOW_WORKSPACE_READ_ONLY=false
